# URL real sin barra final. Si no existe, el sitio usa noindex.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Solo para vistas previas. En producción, mantener false.
SHOW_DEMO_CONTENT=false
# Los anuncios están inactivos; no se carga ningún script de AdSense.

# Identidad legal PUBLICA. No introducir secretos ni documentos de identidad.
SITE_LEGAL_OWNER=
SITE_LEGAL_COUNTRY=
SITE_LEGAL_ADDRESS=
SITE_LEGAL_HOSTING=
# Describir plazos/criterios reales de registros y correspondencia.
SITE_LEGAL_RETENTION=

# Token de verificación de Search Console, sin la etiqueta HTML completa.
GOOGLE_SITE_VERIFICATION=
